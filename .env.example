# CouchDB server connection. Do not put credentials in COUCHDB_URL.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Existing dataset tools and read-only health diagnostics may use the primary dataset.
COUCHDB_DATABASE=recruitment_db

# Auth and Job/Application APIs share this explicitly configured isolated database.
AUTH_COUCHDB_DATABASE=REPLACE_WITH_ISOLATED_DATABASE_NAME
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Recruiter public signup requires recorded Auth and TV2 contract approval.
# Keep disabled until that approval and the recovery runbook are accepted.
PUBLIC_RECRUITER_REGISTRATION_ENABLED=false

# Exact allowed browser origins, comma-separated if needed.
FRONTEND_URL=http://localhost:5173
