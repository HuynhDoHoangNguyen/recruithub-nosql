COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DATABASE=recruitment_db
# Identity must issue signed access tokens for ACTIVE users. No seeded login is provided.
JWT_ALGORITHM=HS256
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional, must match Identity token issuer/audience when set:
JWT_ISSUER=recruithub
JWT_AUDIENCE=recruithub-web
FRONTEND_URL=http://localhost:5173
