# CouchDB server connection. Do not put credentials in COUCHDB_URL.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Public Job reads and read-only health use the primary recruitment dataset.
COUCHDB_DATABASE=recruitment_db

# Keep authentication and protected-write flows isolated by default.
# This database is not created or populated automatically.
AUTH_COUCHDB_DATABASE=REPLACE_WITH_ISOLATED_DATABASE_NAME
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Keep Recruiter signup disabled until organization lookup and TV2 scope checks
# are configured and verified.
PUBLIC_RECRUITER_REGISTRATION_ENABLED=false

# Backend port and exact allowed browser origins.
PORT=5000
FRONTEND_URL=http://127.0.0.1:5178
