# CouchDB server connection. Do not put credentials in COUCHDB_URL.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Public Job reads and read-only health use the primary recruitment dataset.
COUCHDB_DATABASE=recruitment_db

# Auth and domain APIs must use the same database.
# recruitment_db requires explicit opt-in before enabling protected writes.
# For an isolated environment, set BOTH database names to the same new name.
AUTH_COUCHDB_DATABASE=recruitment_db
AUTH_ALLOW_PRIMARY_DATABASE=false
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Keep Recruiter signup disabled until organization lookup and TV2 scope checks
# are configured and verified.
PUBLIC_RECRUITER_REGISTRATION_ENABLED=false
# Enable only for an explicitly authorized local import into the primary DB.
JOB_IMPORT_EXPORT_ALLOW_LIVE_DATABASE=false

# Backend port and exact allowed browser origins.
PORT=5000
FRONTEND_URL=http://127.0.0.1:5178

# Backup signing must use a dedicated key, different from JWT/database secrets.
BACKUP_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_KEY
BACKUP_SIGNING_KEY_ID=local-demo-v1

# Audit/log storage requires a separately provisioned recruithub_logs_* database
# and writer/reader accounts. Leave unset until that provisioning is complete.

# Gemini support chat: backend only. Use an AI Studio Free Tier project.
# Never put this key in VITE_* variables or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPPORT_CHAT_AI_ENABLED=false
SUPPORT_CHAT_TIMEOUT_MS=12000
SUPPORT_CHAT_MAX_OUTPUT_TOKENS=500
SUPPORT_CHAT_RATE_LIMIT_PER_MINUTE=5
SUPPORT_CHAT_MAX_CONCURRENT=2
