# CouchDB server connection. Do not put credentials in COUCHDB_URL.
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# All backend features share the same primary recruitment dataset.
COUCHDB_DATABASE=recruitment_db
AUTH_COUCHDB_DATABASE=recruitment_db
# Explicit opt-in: Auth/Admin writes are allowed on recruitment_db.
AUTH_ALLOW_PRIMARY_DATABASE=true
PORT=5010
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Keep Recruiter signup disabled until organization lookup and downstream TV2
# Job/Application scope integration are configured and verified.
PUBLIC_RECRUITER_REGISTRATION_ENABLED=false

# Exact allowed browser origins, comma-separated if needed.
FRONTEND_URL=http://127.0.0.1:5177
