{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/data/*.test.js tests/foundation/*.test.js tests/recruitment/*.test.js",
    "test:recruitment": "node --test tests/recruitment/*.test.js",
    "test:job-import-export": "node --test tests/recruitment/job-import-export.test.js tests/recruitment/job-import-export.integration.test.js",
    "db:job-application": "node src/repositories/setup-job-application.js",
    "db:admin-statistics": "node src/repositories/setup-admin-statistics.js",
    "etl:extract": "python ../scripts/dataset/extract-parquet.py",
    "etl:transform": "node ../scripts/dataset/transform-staged.js",
    "etl:validate": "node ../scripts/dataset/validate-staged.js",
    "etl": "npm run etl:extract && npm run etl:transform && npm run etl:validate",
    "foundation:generate": "node ../scripts/dataset/generate-foundation.js",
    "foundation:validate": "node ../scripts/dataset/validate-final-foundation.js",
    "foundation": "npm run foundation:generate && npm run foundation:validate",
    "recruitment:generate": "node ../scripts/dataset/generate-recruitment-demo.js",
    "recruitment:validate": "node ../scripts/dataset/validate-recruitment-demo.js",
    "recruitment": "npm run recruitment:generate && npm run recruitment:validate",
    "corpus:generate": "node ../scripts/dataset/generate-resume-analyses.js",
    "corpus:validate": "node ../scripts/dataset/validate-final-corpus.js",
    "corpus": "npm run corpus:generate && npm run corpus:validate",
    "db:import": "node ../scripts/database/import-couchdb.js",
    "db:verify": "node ../scripts/database/verify-couchdb.js",
    "db:load": "npm run db:import && npm run db:verify",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
