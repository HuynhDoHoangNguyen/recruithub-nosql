# Backend API root only. Do not append /v1; service paths already include it.
VITE_API_BASE_URL=http://127.0.0.1:5010/api
# Optional: use the live TV2 public Job API in development; default is labeled fixtures.
# VITE_PUBLIC_JOBS_MODE=api
# Keep disabled until backend organization lookup and TV2 Job/Application scope are ready.
VITE_RECRUITER_REGISTRATION_ENABLED=false
