# Frontend API base is same-origin /api; Vite forwards it to the backend PORT.
# Optional explicit proxy target; use only when backend PORT is unavailable from root/backend .env.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Optional development-only fixture mode. Live API is the default.
# VITE_PUBLIC_JOBS_MODE=fixtures

# Keep Recruiter registration disabled until backend organization checks are ready.
VITE_RECRUITER_REGISTRATION_ENABLED=false
